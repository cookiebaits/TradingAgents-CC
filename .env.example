# -------------------------------------------------------------
# REQUIRED SECRETS (Dokploy & AI Studio Secrets Tab)
# -------------------------------------------------------------
# Set GEMINI_API_KEY in your Dokploy Environment Settings / Secrets Tab.
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# (Optional Alternative: GOOGLE_API_KEY)
GOOGLE_API_KEY=

# -------------------------------------------------------------
# OPTIONAL MULTI-MODEL PROVIDERS
# -------------------------------------------------------------
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_ENDPOINT=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=

# -------------------------------------------------------------
# DOKPLOY / DOCKER CONFIGURATION
# -------------------------------------------------------------
PORT=3000
NODE_ENV=production
